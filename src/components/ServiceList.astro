---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/utils';
import { SERVICES, type Locale } from '../consts';

interface Props {
	lang: Locale;
	// Nivel del título de cada servicio según la página
	headingLevel?: 'h2' | 'h3';
}
const { lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
const services = SERVICES.map((s) => ({
	icon: s.icon,
	title: t(`service.${s.key}title` as any),
	desc: t(`service.${s.key}desc` as any),
	href: `/${lang}/services/${s.slug}/`,
}));
---

<ul class="divide-y divide-line border-y border-line">
	{
		services.map((s) => (
			<li class="grid gap-2 py-6 md:grid-cols-[minmax(0,18rem)_minmax(0,1fr)] md:gap-8">
				<Heading class="flex items-center gap-3 text-lg font-bold">
					<span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper text-ink ring-1 ring-line">
						<Icon name={s.icon} size={22} />
					</span>
					<a href={s.href} class="underline-offset-4 hover:text-call hover:underline">{s.title}</a>
				</Heading>
				<div class="md:pt-2">
					<p class="max-w-prose leading-relaxed text-ink/85">{s.desc}</p>
					<a href={s.href} class="mt-2 inline-flex py-1 font-semibold text-call underline-offset-4 hover:underline">{t('lead.more')} →</a>
				</div>
			</li>
		))
	}
</ul>
