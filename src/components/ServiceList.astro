---
import Icon from './Icon.astro';
import { useTranslations } from '../i18n/utils';
import { SERVICES, type Locale } from '../consts';

interface Props {
	lang: Locale;
	// Nivel del título de cada servicio según la página
	headingLevel?: 'h2' | 'h3';
}
const { lang, headingLevel = 'h3' } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel;
// El aeropuerto va primero y destacado: es lo que más se busca
const order = ['airport-pickup', 'hotel-airport', 'door-to-door'];
const services = [...SERVICES]
	.sort((a, b) => order.indexOf(a.slug) - order.indexOf(b.slug))
	.map((s, i) => ({
		icon: s.icon,
		title: t(`service.${s.key}title` as any),
		desc: t(`service.${s.key}desc` as any),
		href: `/${lang}/services/${s.slug}/`,
		main: i === 0,
	}));
---

<ul class="grid gap-4 md:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)_minmax(0,1fr)]">
	{
		services.map((s) => (
			<li class="flex">
				<a
					href={s.href}
					class:list={[
						'group flex w-full flex-col gap-3 rounded-3xl p-6 transition-colors duration-150 sm:p-7',
						s.main ? 'bg-pine text-paper hover:bg-ink' : 'bg-paper-2 text-ink hover:bg-line',
					]}
				>
					<Icon name={s.icon} size={26} />
					<Heading class="text-2xl leading-tight font-bold hyphens-auto [overflow-wrap:anywhere]">{s.title}</Heading>
					<span class="border-t-2 border-dashed border-current opacity-25" aria-hidden="true"></span>
					<p class="leading-relaxed opacity-90">{s.desc}</p>
					<span class="mt-auto pt-2 font-bold">
						{t('lead.more')} <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span>
					</span>
				</a>
			</li>
		))
	}
</ul>
