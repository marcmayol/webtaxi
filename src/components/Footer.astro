---
import { useTranslations } from '../i18n/utils';
import { BUSINESS_NAME, EMAIL, PHONE_DISPLAY, PHONE_E164, WHATSAPP_URL, type Locale } from '../consts';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-line bg-surface pb-24 md:pb-0">
	<div class="mx-auto grid max-w-5xl gap-8 px-4 py-10 sm:px-6 md:grid-cols-[1.4fr_1fr]">
		<div class="flex flex-col gap-2">
			<p class="text-lg font-bold">{BUSINESS_NAME}</p>
			<p class="text-muted">{t('footer.area')}</p>
			<p class="text-muted">{t('footer.hours')}</p>
			<p class="mt-2 flex flex-col gap-1">
				<a href={`tel:${PHONE_E164}`} class="w-fit text-xl font-bold hover:text-call">{PHONE_DISPLAY}</a>
				<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="w-fit underline underline-offset-4 hover:text-whatsapp">WhatsApp</a>
				<a href={`mailto:${EMAIL}`} class="w-fit underline underline-offset-4 hover:text-call">{EMAIL}</a>
			</p>
		</div>
		<nav class="flex flex-col gap-2 md:items-end" aria-label={BUSINESS_NAME}>
			<a href={`/${lang}/services/`} class="w-fit py-1 underline underline-offset-4 hover:text-call">{t('footer.service')}</a>
			<a href={`/${lang}/about/`} class="w-fit py-1 underline underline-offset-4 hover:text-call">{t('footer.about')}</a>
		</nav>
	</div>
	<div class="border-t border-line">
		<div class="mx-auto flex max-w-5xl flex-wrap justify-between gap-2 px-4 py-4 text-sm text-muted sm:px-6">
			<p>&copy; {year} {BUSINESS_NAME}. {t('footer.rights')}</p>
			<p><a href="https://marcmayol.com/" class="hover:text-ink">{t('footer.credit')}</a></p>
		</div>
	</div>
</footer>
