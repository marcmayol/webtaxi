---
import { useTranslations } from '../i18n/utils';
import { BUSINESS_NAME, EMAIL, PHONE_DISPLAY, PHONE_E164, WHATSAPP_URL, type Locale } from '../consts';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="mt-20 bg-paper-2 pb-24 md:pb-0">
	<div class="mx-auto grid max-w-6xl grid-cols-[minmax(0,1fr)] gap-8 px-4 py-10 sm:px-8 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
		<div class="flex flex-col gap-2">
			<p class="font-display text-xl font-bold">{BUSINESS_NAME}</p>
			<p class="text-muted">{t('footer.area')}</p>
			<p class="text-muted">{t('footer.hours')}</p>
			<p class="mt-2 flex flex-col">
				<a href={`tel:${PHONE_E164}`} class="inline-flex min-h-11 w-fit items-center font-display text-2xl font-bold tabular-nums hover:text-accent">{PHONE_DISPLAY}</a>
				<a href={WHATSAPP_URL} target="_blank" rel="noopener" class="inline-flex min-h-11 w-fit items-center underline underline-offset-4 hover:text-whatsapp">WhatsApp</a>
				<a href={`mailto:${EMAIL}`} class="inline-flex min-h-11 w-fit max-w-full items-center underline underline-offset-4 [overflow-wrap:anywhere] hover:text-call">{EMAIL}</a>
			</p>
		</div>
		<nav class="flex flex-col md:items-end" aria-label={BUSINESS_NAME}>
			<a href={`/${lang}/services/`} class="inline-flex min-h-11 w-fit items-center underline underline-offset-4 hover:text-call">{t('footer.service')}</a>
			<a href={`/${lang}/about/`} class="inline-flex min-h-11 w-fit items-center underline underline-offset-4 hover:text-call">{t('footer.about')}</a>
		</nav>
	</div>
	<div class="border-t border-line">
		<div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-2 px-4 py-4 text-sm text-muted sm:px-8">
			<p>&copy; {year} {BUSINESS_NAME}. {t('footer.rights')}</p>
			<p><a href="https://marcmayol.com/" class="inline-flex min-h-11 items-center hover:text-ink">{t('footer.credit')}</a></p>
		</div>
	</div>
</footer>
