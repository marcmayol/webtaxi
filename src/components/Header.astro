---
import { changeroutelang, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';
import { BUSINESS_NAME, PHONE_DISPLAY, PHONE_E164, type Locale } from '../consts';
import Icon from './Icon.astro';

interface Props {
	lang: Locale;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<header class="border-b border-line bg-surface">
	<div class="mx-auto flex max-w-5xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
		<a href={`/${lang}/`} class="flex items-center gap-2.5 text-lg font-bold tracking-tight text-ink">
			<img src="/img/logo-96.webp" alt="" width="40" height="40" class="size-10" />
			{BUSINESS_NAME}
		</a>
		<div class="flex items-center gap-3">
			<a href={`tel:${PHONE_E164}`} aria-label={t('contact.callAria')} class="hidden items-center gap-2 font-bold text-ink hover:text-call md:inline-flex">
				<Icon name="phone" />
				{PHONE_DISPLAY}
			</a>
			<details class="relative" data-langmenu>
				<summary class="flex h-11 cursor-pointer list-none items-center gap-2 rounded-full border border-line px-4 text-sm font-bold text-ink transition-colors duration-150 hover:border-ink [&::-webkit-details-marker]:hidden">
					<Icon name="globe" />
					<span class="uppercase">{lang}</span>
					<span class="sr-only">{t('nav.button')}</span>
				</summary>
				<ul class="absolute right-0 z-20 mt-2 min-w-40 rounded-xl border border-line bg-surface py-1 shadow-lg">
					{
						Object.entries(languages).map(([code, label]) => (
							<li>
								<a
									href={changeroutelang(Astro.url, code)}
									hreflang={code}
									lang={code}
									aria-current={code === lang ? 'true' : undefined}
									class:list={['block px-4 py-2.5 hover:bg-paper', code === lang ? 'font-bold text-ink' : 'text-muted']}
								>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</details>
		</div>
	</div>
</header>

<script is:inline>
	// Cierra el menú de idioma al pulsar fuera
	document.addEventListener('click', (e) => {
		const menu = document.querySelector('[data-langmenu]');
		if (menu && menu.open && !menu.contains(e.target)) menu.open = false;
	});
</script>
