---
import Page from '../../layouts/Page.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import Icon from '../../components/Icon.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';
import { BUSINESS_ID, businessSchema, type Locale } from '../../consts';

export const getStaticPaths = getLangPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const drivers = [
	{ name: t('about.drivers1.title'), role: t('about.drivers1.subtitle'), text: t('about.drivers1.description'), photo: '/img/maria-256.webp' },
	{ name: t('about.drivers2.title'), role: t('about.drivers2.subtitle'), text: t('about.drivers2.description'), photo: '/img/xisco-256.webp' },
];
const reasons = [
	{ icon: 'car', label: t('about.chooseus.1') },
	{ icon: 'clock', label: t('about.chooseus.2') },
	{ icon: 'smiley', label: t('about.chooseus.3') },
] as const;
const schema = [
	{
		...businessSchema(lang, t('about.seo.description')),
		employee: drivers.map((d) => ({ '@type': 'Person', name: d.name, jobTitle: d.role, worksFor: { '@id': BUSINESS_ID } })),
	},
];
---

<Page lang={lang} path="about/" title={t('about.seo.title')} description={t('about.seo.description')} keywords={t('about.seo.keywords')} schema={schema}>
	<section class="mt-10 sm:mt-14">
		<h1 class="text-3xl font-extrabold tracking-tight hyphens-auto [overflow-wrap:anywhere] sm:text-4xl">{t('about.title')}</h1>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink/85">{t('about.description')}</p>
	</section>

	<section class="mt-14">
		<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t('about.story.title')}</h2>
		<p class="mt-4 max-w-prose leading-relaxed text-ink/85">{t('about.story.description')}</p>
	</section>

	<section class="mt-14">
		<h2 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{t('about.drivers.title')}</h2>
		<ul class="grid gap-8 md:grid-cols-2">
			{
				drivers.map((d) => (
					<li class="flex flex-col gap-4 sm:flex-row sm:items-start">
						<img src={d.photo} alt={d.name} width="128" height="128" loading="lazy" class="size-28 shrink-0 rounded-full object-cover" />
						<div>
							<h3 class="text-xl font-bold">{d.name}</h3>
							<p class="text-muted">{d.role}</p>
							<p class="mt-2 leading-relaxed text-ink/85">{d.text}</p>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-14">
		<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t('about.mision.title')}</h2>
		<p class="mt-4 max-w-prose leading-relaxed text-ink/85">{t('about.mision.description')}</p>
	</section>

	<section class="mt-14">
		<h2 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{t('about.chooseus.title')}</h2>
		<ul class="flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-x-10">
			{
				reasons.map((r) => (
					<li class="flex items-center gap-3 text-lg font-semibold">
						<Icon name={r.icon} size={24} />
						{r.label}
					</li>
				))
			}
		</ul>
	</section>

	<section class="mt-14">
		<h2 class="text-2xl font-bold tracking-tight sm:text-3xl">{t('contact.title')}</h2>
		<p class="mt-4 mb-6 max-w-prose leading-relaxed text-ink/85">{t('about.contact.desc')}</p>
		<ContactDetails lang={lang} />
	</section>
</Page>
