---
import Page from '../../layouts/Page.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import ServiceList from '../../components/ServiceList.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';
import { BUSINESS_ID, SERVICES, SITE_URL, businessSchema, type Locale } from '../../consts';

export const getStaticPaths = getLangPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

// Mismos @id que en cada página de servicio, para que Google las una
const schema = [
	businessSchema(lang, t('seo.description')),
	...SERVICES.map((s) => ({
		'@type': 'Service',
		'@id': `${SITE_URL}/#service-${s.slug}`,
		name: t(`service.${s.key}title` as any),
		serviceType: t(`service.${s.key}title` as any),
		description: t(`service.${s.key}desc` as any),
		provider: { '@id': BUSINESS_ID },
		url: `${SITE_URL}/${lang}/services/${s.slug}/`,
	})),
];
---

<Page lang={lang} path="services/" title={t('services.seo.title')} description={t('services.seo.description')} keywords={t('seo.keywords')} schema={schema}>
	<section class="pt-6 sm:pt-10">
		<h1 class="text-4xl font-bold tracking-[-0.035em] hyphens-auto [overflow-wrap:anywhere] sm:text-6xl">{t('service.title')}</h1>
		<p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{t('service.desc')}</p>
	</section>

	<section class="mt-10">
		<ServiceList lang={lang} headingLevel="h2" />
	</section>

	<ContactButtons lang={lang} class="mt-10 flex-wrap" />
</Page>
