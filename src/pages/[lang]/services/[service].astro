---
import Page from '../../../layouts/Page.astro';
import ContactButtons from '../../../components/ContactButtons.astro';
import Icon from '../../../components/Icon.astro';
import { useTranslations } from '../../../i18n/utils';
import { AREA_SERVED, BUSINESS_ID, LOCALES, SERVICES, SITE_URL, businessSchema, type Locale, type Service } from '../../../consts';

export function getStaticPaths() {
	return LOCALES.flatMap((lang) => SERVICES.map((service) => ({ params: { lang, service: service.slug }, props: { service } })));
}

const lang = Astro.params.lang as Locale;
const { service } = Astro.props as { service: Service };
const t = useTranslations(lang);
const tk = (key: string) => t(key as any);

const title = tk(`service.${service.key}title`);
const desc = tk(`service.${service.key}desc`);
const waText = `${t('lead.wa')} ${title}`;
const url = `${SITE_URL}/${lang}/services/${service.slug}/`;
const others = SERVICES.filter((s) => s.slug !== service.slug);
const facts = [
	{ icon: 'clock', text: t('footer.hours') },
	{ icon: 'car', text: t('lead.seats') },
	{ icon: 'receipt', text: t('lead.rate') },
] as const;

const schema = [
	businessSchema(lang, t('seo.description')),
	{
		'@type': 'Service',
		'@id': `${SITE_URL}/#service-${service.slug}`,
		name: title,
		serviceType: title,
		description: desc,
		url,
		provider: { '@id': BUSINESS_ID },
		areaServed: AREA_SERVED.map((name) => ({ '@type': 'Place', name })),
	},
];
---

<Page lang={lang} path={`services/${service.slug}/`} title={tk(`${service.seo}.seo.title`)} description={tk(`${service.seo}.seo.description`)} schema={schema} waText={waText}>
	<section class="mt-4 rounded-[1.75rem] bg-pine px-6 py-10 text-paper sm:mt-8 sm:px-12 sm:py-16">
		<span class="grid size-12 place-items-center rounded-full bg-paper/15">
			<Icon name={service.icon} size={26} />
		</span>
		<h1 class="mt-5 max-w-3xl text-4xl leading-[1] font-bold tracking-[-0.035em] hyphens-auto [overflow-wrap:anywhere] sm:text-6xl">{title}</h1>
		<p class="mt-5 max-w-2xl text-lg leading-relaxed text-paper/90">{desc}</p>
		<ContactButtons lang={lang} waText={waText} class="mt-8 hidden flex-wrap md:flex" />
	</section>

	<section class="mt-14 grid gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
		<div>
			<h2 class="mb-5 text-3xl font-bold">{t('lead.facts')}</h2>
			<ul class="flex flex-col gap-4">
				{
					facts.map((f) => (
						<li class="flex items-center gap-3 text-lg font-semibold">
							<span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper-2 text-pine"><Icon name={f.icon} size={20} /></span>
							{f.text}
						</li>
					))
				}
			</ul>
		</div>
		<div>
			<h2 class="mb-5 text-3xl font-bold">{t('lead.areas')}</h2>
			<ul class="flex flex-wrap gap-2">
				{AREA_SERVED.map((a) => <li class="rounded-full bg-paper-2 px-4 py-2 font-medium">{a}</li>)}
			</ul>
		</div>
	</section>

	<section class="mt-14 rounded-[1.75rem] bg-paper-2 px-6 py-10 sm:px-12">
		<h2 class="text-3xl font-bold tabular-nums sm:text-4xl">{t('lead.cta.title')}</h2>
		<p class="mt-3 text-lg text-muted">{t('lead.cta.desc')}</p>
		<ContactButtons lang={lang} waText={waText} class="mt-6 flex-wrap" />
	</section>

	<section class="mt-14">
		<h2 class="mb-5 text-3xl font-bold">{t('lead.others')}</h2>
		<ul class="grid gap-3 sm:grid-cols-2">
			{
				others.map((s) => (
					<li class="flex">
						<a href={`/${lang}/services/${s.slug}/`} class="group flex w-full flex-col gap-3 rounded-3xl bg-paper-2 p-6 transition-colors duration-150 hover:bg-line">
							<Icon name={s.icon} size={24} />
							<span class="font-display text-xl font-bold tracking-tight hyphens-auto [overflow-wrap:anywhere]">{tk(`service.${s.key}title`)}</span>
							<span class="border-t-2 border-dashed border-current opacity-25" aria-hidden="true"></span>
							<span class="font-bold">{t('lead.more')} <span aria-hidden="true" class="inline-block transition-transform duration-150 group-hover:translate-x-1">→</span></span>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</Page>
