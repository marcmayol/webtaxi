---
import Page from '../../layouts/Page.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import ServiceList from '../../components/ServiceList.astro';
import Icon from '../../components/Icon.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';
import { BUSINESS_ID, BUSINESS_NAME, PHONE_DISPLAY, PHONE_E164, SITE_URL, businessSchema, type Locale } from '../../consts';

export const getStaticPaths = getLangPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const schema = [
	{
		'@type': 'WebSite',
		'@id': `${SITE_URL}/#website`,
		url: `${SITE_URL}/${lang}/`,
		name: BUSINESS_NAME,
		inLanguage: lang,
		publisher: { '@id': BUSINESS_ID },
	},
	businessSchema(lang, t('seo.description')),
];

// «Cala Rajada» va en el color de acento dentro del titular
const title = t('header.title');
const [titleBefore, titleAfter = ''] = title.split('Cala Rajada');
const hasPlace = title.includes('Cala Rajada');
const facts = [
	{ icon: 'clock', text: t('footer.hours') },
	{ icon: 'car', text: t('lead.seats') },
	{ icon: 'receipt', text: t('lead.rate') },
] as const;
---

<Page lang={lang} path="" title={t('seo.title')} description={t('seo.description')} keywords={t('seo.keywords')} schema={schema}>
	<link slot="head" rel="preload" as="image" type="image/webp" imagesrcset="/img/taxi-800.webp 800w, /img/taxi-1280.webp 1280w, /img/taxi-1920.webp 1920w" imagesizes="(min-width: 1200px) 1088px, 100vw" fetchpriority="high" />

	<section class="grid gap-6 pt-6 pb-10 sm:pt-10 sm:pb-14 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] md:items-end md:gap-10">
		<h1 class="text-[2.75rem] leading-[0.95] font-bold tracking-[-0.035em] hyphens-auto [overflow-wrap:anywhere] sm:text-6xl lg:text-7xl">
			{hasPlace ? <Fragment>{titleBefore}<span class="text-accent">Cala Rajada</span>{titleAfter}</Fragment> : title}
		</h1>
		<p class="text-lg leading-relaxed text-muted">{t('header.description')}</p>
	</section>

	<section class="relative">
		<div class="overflow-hidden rounded-[1.75rem] bg-paper-2">
			<img
				src="/img/taxi-1280.webp"
				srcset="/img/taxi-800.webp 800w, /img/taxi-1280.webp 1280w, /img/taxi-1920.webp 1920w"
				sizes="(min-width: 1200px) 1088px, 100vw"
				width="1280"
				height="960"
				alt={BUSINESS_NAME}
				fetchpriority="high"
				class="aspect-[16/10] w-full object-cover object-[50%_45%] sm:aspect-[16/9] lg:aspect-[21/9]"
			/>
		</div>
		<div class="relative z-10 mx-3 -mt-14 flex flex-col gap-3 rounded-3xl bg-surface p-5 shadow-card sm:absolute sm:bottom-7 sm:left-7 sm:mx-0 sm:mt-0 sm:w-[23rem] sm:p-6">
			<p class="text-sm font-semibold text-pine">{t('home.stop')}</p>
			<a href={`tel:${PHONE_E164}`} aria-label={t('contact.callAria')} class="inline-flex min-h-12 w-fit items-center font-display text-4xl font-bold tracking-tight tabular-nums hover:text-accent">{PHONE_DISPLAY.replace('+34 ', '')}</a>
			<ContactButtons lang={lang} stretch class="hidden sm:flex" />
		</div>
	</section>

	<ul class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-x-10">
		{
			facts.map((f) => (
				<li class="flex items-center gap-3 font-semibold">
					<span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper-2 text-pine"><Icon name={f.icon} size={20} /></span>
					{f.text}
				</li>
			))
		}
	</ul>

	<section class="mt-16 sm:mt-20">
		<h2 class="mb-7 text-4xl font-bold sm:text-5xl">{t('service.title')}</h2>
		<ServiceList lang={lang} />
	</section>

	<section class="mt-16 grid items-center gap-8 sm:mt-24 md:grid-cols-[auto_minmax(0,1fr)] md:gap-14">
		<div class="flex">
			<img src="/img/maria-256.webp" alt={t('about.drivers1.title')} width="160" height="160" loading="lazy" class="size-[min(8rem,38vw)] rounded-full border-[5px] border-paper object-cover sm:size-40" />
			<img src="/img/xisco-256.webp" alt={t('about.drivers2.title')} width="160" height="160" loading="lazy" class="-ml-7 size-[min(8rem,38vw)] rounded-full border-[5px] border-paper object-cover sm:size-40" />
		</div>
		<div>
			<h2 class="text-4xl font-bold hyphens-auto [overflow-wrap:anywhere] sm:text-5xl">María &amp; Xisco</h2>
			<p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{t('home.family.desc')}</p>
			<a href={`/${lang}/about/`} class="mt-3 inline-flex min-h-11 items-center font-bold text-accent underline-offset-4 hover:underline">{t('home.family.link')} →</a>
		</div>
	</section>
</Page>
