---
import Page from '../../layouts/Page.astro';
import ContactButtons from '../../components/ContactButtons.astro';
import ContactDetails from '../../components/ContactDetails.astro';
import ServiceList from '../../components/ServiceList.astro';
import { getLangPaths, useTranslations } from '../../i18n/utils';
import { BUSINESS_ID, BUSINESS_NAME, SITE_URL, businessSchema, type Locale } from '../../consts';

export const getStaticPaths = getLangPaths;
const lang = Astro.params.lang as Locale;
const t = useTranslations(lang);

const schema = [
	{
		'@type': 'WebSite',
		'@id': `${SITE_URL}/#website`,
		url: `${SITE_URL}/${lang}/`,
		name: BUSINESS_NAME,
		inLanguage: lang,
		publisher: { '@id': BUSINESS_ID },
	},
	businessSchema(lang, t('seo.description')),
];

---

<Page lang={lang} path="" title={t('seo.title')} description={t('seo.description')} keywords={t('seo.keywords')} schema={schema}>
	<link slot="head" rel="preload" as="image" type="image/webp" imagesrcset="/img/taxi-800.webp 800w, /img/taxi-1280.webp 1280w, /img/taxi-1920.webp 1920w" imagesizes="(min-width: 1024px) 976px, 100vw" fetchpriority="high" />

	<section class="relative mt-4 overflow-hidden rounded-2xl bg-ink sm:mt-6">
		<img
			src="/img/taxi-1280.webp"
			srcset="/img/taxi-800.webp 800w, /img/taxi-1280.webp 1280w, /img/taxi-1920.webp 1920w"
			sizes="(min-width: 1024px) 976px, 100vw"
			width="1280"
			height="960"
			alt={BUSINESS_NAME}
			fetchpriority="high"
			class="absolute inset-0 size-full object-cover object-[50%_40%]"
		/>
		<div class="absolute inset-0 bg-linear-to-t from-black/85 via-black/55 to-black/10"></div>
		<div class="relative flex min-h-[26rem] flex-col justify-end gap-5 p-6 sm:min-h-[30rem] sm:p-10">
			<h1 class="max-w-2xl text-4xl leading-[1.05] font-extrabold tracking-tight text-balance hyphens-auto text-white [overflow-wrap:anywhere] sm:text-5xl">{t('header.title')}</h1>
			<p class="max-w-2xl text-base leading-relaxed text-white/90 sm:text-lg">{t('header.description')}</p>
			<ContactButtons lang={lang} class="flex-wrap" />
		</div>
	</section>

	<section class="mt-16">
		<h2 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{t('service.title')}</h2>
		<ServiceList lang={lang} />
	</section>

	<section class="mt-16">
		<h2 class="mb-6 text-2xl font-bold tracking-tight sm:text-3xl">{t('contact.title')}</h2>
		<ContactDetails lang={lang} />
	</section>
</Page>
